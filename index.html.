    <!-- JAVASCRIPT ENGINE -->
    <script>
        // Local Memory & Application State
        let posts = [];
        let currentRoom = 'general';
        let currentFilter = 'all';
        let isAdmin = false;
        let selectedCause = 'project';
        let selectedMediaData = null;
        let favoritePostIds = new Set();

        // --- RIPPLE CANVAS EFFECT ---
        const canvas = document.getElementById('ripple-canvas');
        const ctx = canvas.getContext('2d');
        let ripples = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        window.addEventListener('click', (e) => {
            ripples.push({ x: e.clientX, y: e.clientY, radius: 5, alpha: 0.8 });
        });

        function animateRipples() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            for (let i = ripples.length - 1; i >= 0; i--) {
                const r = ripples[i];
                ctx.beginPath();
                ctx.arc(r.x, r.y, r.radius, 0, Math.PI * 2);
                ctx.strokeStyle = `rgba(56, 189, 248, ${r.alpha})`;
                ctx.lineWidth = 2;
                ctx.stroke();
                r.radius += 2.5;
                r.alpha -= 0.025;
                if (r.alpha <= 0) ripples.splice(i, 1);
            }
            requestAnimationFrame(animateRipples);
        }
        animateRipples();

        // --- CLOCK ---
        setInterval(() => {
            const clockEl = document.getElementById('aero-clock');
            if (clockEl) clockEl.textContent = new Date().toLocaleTimeString();
        }, 1000);

        // --- SAMPLE INITIAL POSTS ---
        function loadSamplePosts() {
            posts = [
                {
                    id: '1',
                    room: 'general',
                    username: 'AquaMaster',
                    isAdmin: true,
                    text: '¡Bienvenidos a AquaNet! Disfruten de la experiencia cristalina, compartan imágenes y usen los canales.',
                    timestamp: '10:30 AM',
                    favs: 5,
                    reports: 0,
                    media: null,
                    reactions: { '💧': 4, '💖': 2 }
                },
                {
                    id: '2',
                    room: 'general',
                    username: 'NostalgicoAero',
                    isAdmin: false,
                    text: 'El estilo Frutiger Aero en AquaNet se ve genial. ¡Totalmente retro-futurista!',
                    timestamp: '10:42 AM',
                    favs: 8,
                    reports: 0,
                    media: null,
                    reactions: { '🔮': 3, '☀️': 5 }
                }
            ];
            renderPosts();
        }

        // --- RENDER ENGINE ---
        function renderPosts() {
            const container = document.getElementById('posts-container');
            if (!container) return;

            const searchInput = document.getElementById('search-input')?.value.toLowerCase() || '';
            let filtered = posts.filter(p => p.room === currentRoom);

            if (currentFilter === 'favorites') {
                filtered = filtered.filter(p => favoritePostIds.has(p.id));
            }

            if (searchInput) {
                filtered = filtered.filter(p => p.text.toLowerCase().includes(searchInput) || p.username.toLowerCase().includes(searchInput));
            }

            document.getElementById('count-all').textContent = posts.filter(p => p.room === currentRoom).length;
            document.getElementById('count-favs').textContent = favoritePostIds.size;

            updateFeaturedPost();

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="aero-glass rounded-2xl p-8 text-center text-sky-900/60 font-semibold">
                        <i class="fa-solid fa-water text-3xl mb-2 text-sky-400"></i>
                        <p>No hay mensajes en esta vista de AquaNet.</p>
                    </div>`;
                return;
            }

            container.innerHTML = filtered.map(post => {
                const isFav = favoritePostIds.has(post.id);
                return `
                <div class="aero-glass rounded-2xl p-4 shadow-md border border-white/80 relative flex flex-col gap-2">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="font-extrabold text-xs ${post.isAdmin ? 'text-emerald-700' : 'text-sky-950'} flex items-center gap-1">
                                ${post.username} ${post.isAdmin ? '<i class="fa-solid fa-circle-check text-emerald-500" title="Admin Oficial"></i>' : ''}
                            </span>
                            <span class="text-[10px] text-sky-900/50 font-semibold">${post.timestamp}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="toggleFavorite('${post.id}')" class="text-xs ${isFav ? 'text-amber-500' : 'text-sky-900/40 hover:text-amber-500'}">
                                <i class="fa-solid fa-star"></i>
                            </button>
                            <button onclick="reportPost('${post.id}')" class="text-xs text-sky-900/40 hover:text-rose-500" title="Reportar">
                                <i class="fa-solid fa-flag"></i>
                            </button>
                            ${isAdmin ? `
                                <button onclick="censorePost('${post.id}')" class="text-xs text-amber-600 font-bold">Censurar</button>
                                <button onclick="deletePost('${post.id}')" class="text-xs text-rose-600 font-bold"><i class="fa-solid fa-trash"></i></button>
                            ` : ''}
                        </div>
                    </div>

                    <p class="text-sm font-medium text-slate-800 leading-relaxed">${post.text}</p>

                    ${post.media ? renderMediaElement(post.media) : ''}

                    <div class="flex items-center justify-between mt-2 pt-2 border-t border-white/40 text-xs">
                        <div class="flex items-center gap-1.5">
                            ${Object.entries(post.reactions || {}).map(([emoji, count]) => `
                                <button onclick="reactPost('${post.id}', '${emoji}')" class="aero-btn px-2 py-0.5 rounded-lg text-[11px] font-bold text-sky-900">
                                    ${emoji}${count}
                                </button>
                            `).join('')}
                        </div>
                        <button onclick="reactPost('${post.id}', '💧')" class="aero-btn px-2.5 py-1 rounded-lg text-[11px] font-bold text-sky-900">
                            + Reaccionar 💧
                        </button>
                    </div>
                </div>`;
            }).join('');
        }

        function renderMediaElement(media) {
            if (media.type.startsWith('image/')) {
                return `<img src="${media.url}" class="max-h-60 rounded-xl object-cover border border-white/80 shadow-sm mt-1">`;
            } else if (media.type.startsWith('audio/')) {
                return `<audio controls src="${media.url}" class="w-full mt-1"></audio>`;
            } else if (media.type.startsWith('video/')) {
                return `<video controls src="${media.url}" class="max-h-60 w-full rounded-xl mt-1"></video>`;
            }
            return '';
        }

        function submitPost() {
            const input = document.getElementById('post-input');
            const username = document.getElementById('username-input').value || 'Anónimo';
            const text = input.value.trim();

            if (!text && !selectedMediaData) return;

            posts.unshift({
                id: Date.now().toString(),
                room: currentRoom,
                username: username,
                isAdmin: isAdmin,
                text: text || '(Archivo Multimedia)',
                timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
                favs: 0,
                reports: 0,
                media: selectedMediaData,
                reactions: { '💧': 1 }
            });

            input.value = '';
            clearMedia();
            renderPosts();
        }

        function handleMediaSelect(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(evt) {
                selectedMediaData = { type: file.type, url: evt.target.result, name: file.name };
                document.getElementById('media-preview-name').textContent = file.name;
                document.getElementById('media-preview-box').classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        }

        function clearMedia() {
            selectedMediaData = null;
            document.getElementById('media-preview-box')?.classList.add('hidden');
        }

        function addSticker(emoji) {
            const input = document.getElementById('post-input');
            if (input) input.value += ' ' + emoji;
        }

        function updateFeaturedPost() {
            const banner = document.getElementById('featured-post-banner');
            const content = document.getElementById('featured-post-content');
            if (!banner || !content || posts.length === 0) return;

            const topPost = [...posts].sort((a,b) => (b.favs || 0) - (a.favs || 0))[0];
            if (topPost) {
                banner.classList.remove('hidden');
                content.innerHTML = `<strong>${topPost.username}:</strong> "${topPost.text}"`;
            }
        }

        function toggleFavorite(id) {
            favoritePostIds.has(id) ? favoritePostIds.delete(id) : favoritePostIds.add(id);
            renderPosts();
        }

        function reactPost(id, emoji) {
            const post = posts.find(p => p.id === id);
            if (post) {
                if (!post.reactions) post.reactions = {};
                post.reactions[emoji] = (post.reactions[emoji] || 0) + 1;
                post.favs = (post.favs || 0) + 1;
                renderPosts();
            }
        }

        function reportPost(id) {
            const post = posts.find(p => p.id === id);
            if (post) {
                post.reports = (post.reports || 0) + 1;
                alert('Publicación reportada a moderación.');
                updateAdminReportList();
            }
        }

        function censorePost(id) {
            const post = posts.find(p => p.id === id);
            if (post) {
                post.text = '🛑 [ Mensaje censurado por el Admin ]';
                renderPosts();
            }
        }

        function deletePost(id) {
            posts = posts.filter(p => p.id !== id);
            renderPosts();
        }

        function clearCurrentRoom() {
            if (confirm('¿Vaciar la sala actual?')) {
                posts = posts.filter(p => p.room !== currentRoom);
                renderPosts();
            }
        }

        function switchRoom(room) {
            currentRoom = room;
            ['general', 'multimedia', 'lounge'].forEach(r => {
                const btn = document.getElementById(`room-${r}`);
                if (btn) {
                    if (r === room) {
                        btn.classList.add('border-l-4', 'border-l-sky-500', 'opacity-100');
                    } else {
                        btn.classList.remove('border-l-4', 'border-l-sky-500');
                        btn.classList.add('opacity-80');
                    }
                }
            });
            renderPosts();
        }

        function setFilter(filter) {
            currentFilter = filter;
            renderPosts();
        }

        function changeTheme(themeClass) {
            document.body.className = `${themeClass} min-h-screen text-slate-800 relative overflow-x-hidden`;
        }

        // DONATIONS
        function openDonateModal() { document.getElementById('modal-donate')?.classList.remove('hidden'); }
        function closeDonateModal() { document.getElementById('modal-donate')?.classList.add('hidden'); }
        
        function selectCause(cause) {
            selectedCause = cause;
            document.getElementById('cause-project').className = cause === 'project' ? "aero-btn p-3 rounded-2xl text-left border-2 border-emerald-500 bg-emerald-50/50" : "aero-btn p-3 rounded-2xl text-left border-2 border-transparent";
            document.getElementById('cause-creator').className = cause === 'creator' ? "aero-btn p-3 rounded-2xl text-left border-2 border-amber-500 bg-amber-50/50" : "aero-btn p-3 rounded-2xl text-left border-2 border-transparent";
        }

        function setAmount(val) { document.getElementById('custom-amount').value = val; }

        function processDonation() {
            const amount = document.getElementById('custom-amount').value || '5';
            const causeText = selectedCause === 'project' ? 'Apoyo al Proyecto AquaNet' : 'Apoyo al Creador';
            alert(`🎉 Redirigiendo a PayPal para completar la donación de $${amount} USD para "${causeText}"...`);
            closeDonateModal();
        }

        // ADMIN
        function openAdminModal() { document.getElementById('modal-admin')?.classList.remove('hidden'); }
        function closeAdminModal() { document.getElementById('modal-admin')?.classList.add('hidden'); }

        function verifyAdminPass() {
            if (document.getElementById('admin-pass-input').value === 'admin123') {
                isAdmin = true;
                document.getElementById('admin-auth-box').classList.add('hidden');
                document.getElementById('admin-controls').classList.remove('hidden');
                updateAdminReportList();
                renderPosts();
            } else {
                alert('Clave incorrecta.');
            }
        }

        function promoteSelfAdmin() {
            isAdmin = true;
            document.getElementById('user-role-badge').textContent = 'ADMINISTRADOR';
            document.getElementById('user-role-badge').className = 'text-[10px] font-bold text-emerald-800 bg-emerald-200/80 px-2 py-0.5 rounded-full inline-block mt-1';
            alert('¡Ahora eres Administrador Oficial en AquaNet!');
            renderPosts();
        }

        function updateAdminReportList() {
            const list = document.getElementById('reported-list');
            const countEl = document.getElementById('reported-count');
            const reported = posts.filter(p => p.reports > 0);
            
            if (countEl) countEl.textContent = reported.length;
            if (!list) return;

            if (reported.length === 0) {
                list.innerHTML = `<p class="text-[11px] text-slate-500 italic">No hay reportes pendientes.</p>`;
                return;
            }

            list.innerHTML = reported.map(p => `
                <div class="flex items-center justify-between bg-white/60 p-2 rounded-xl">
                    <span class="truncate max-w-[200px]"><strong>${p.username}:</strong> ${p.text}</span>
                    <button onclick="deletePost('${p.id}')" class="text-red-600 font-bold px-2 py-0.5 rounded bg-red-100">Borrar</button>
                </div>
            `).join('');
        }

        loadSamplePosts();
    </script>
</body>
</html>