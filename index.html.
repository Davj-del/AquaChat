<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AquaNet - The Crystal Clear Network</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Segoe+UI:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <!-- Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>

    <style>
        * {
            font-family: 'Segoe UI', 'Trebuchet MS', sans-serif;
            user-select: none;
        }

        /* Frutiger Aero Background Themes */
        .theme-sky {
            background: linear-gradient(135deg, #0284c7 0%, #38bdf8 40%, #a5f3fc 70%, #f0fdf4 100%);
        }
        .theme-sunset {
            background: linear-gradient(135deg, #0284c7 0%, #818cf8 35%, #c084fc 65%, #fbcfe8 100%);
        }
        .theme-emerald {
            background: linear-gradient(135deg, #0369a1 0%, #0d9488 40%, #34d399 75%, #ecfdf5 100%);
        }
        .theme-night {
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 40%, #0369a1 80%, #0891b2 100%);
        }

        /* Aero Glass Effect */
        .aero-glass {
            background: rgba(255, 255, 255, 0.45);
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.65);
            box-shadow: 0 8px 32px 0 rgba(0, 100, 180, 0.2), 
                        inset 0 1px 0 0 rgba(255, 255, 255, 0.9),
                        inset 0 -1px 0 0 rgba(0, 0, 0, 0.1);
        }

        /* Shiny Aero Buttons */
        .aero-btn {
            background: linear-gradient(180deg, 
                rgba(255,255,255,0.9) 0%, 
                rgba(255,255,255,0.4) 48%, 
                rgba(200,230,255,0.5) 52%, 
                rgba(150,210,255,0.8) 100%);
            border: 1px solid rgba(0, 120, 215, 0.5);
            box-shadow: 0 2px 5px rgba(0,0,0,0.15), inset 0 1px 0 rgba(255,255,255,0.9);
            transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
        }
        .aero-btn:hover {
            background: linear-gradient(180deg, 
                rgba(255,255,255,1) 0%, 
                rgba(220,240,255,0.6) 48%, 
                rgba(170,225,255,0.7) 52%, 
                rgba(100,190,255,0.9) 100%);
            border-color: #0284c7;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35), inset 0 1px 0 #fff;
            transform: translateY(-1px);
        }
        .aero-btn:active {
            transform: translateY(1px);
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.2);
        }

        .aero-btn-emerald {
            background: linear-gradient(180deg, 
                rgba(255,255,255,0.9) 0%, 
                rgba(209,250,229,0.5) 48%, 
                rgba(167,243,208,0.6) 52%, 
                rgba(52,211,153,0.8) 100%);
            border: 1px solid rgba(16, 185, 129, 0.5);
        }

        /* Aero Scrollbars */
        ::-webkit-scrollbar {
            width: 10px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 5px;
        }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, rgba(56,189,248,0.8), rgba(2,132,199,0.8));
            border-radius: 5px;
            border: 2px solid rgba(255,255,255,0.4);
        }

        /* Dynamic Water Ripple Canvas */
        #ripple-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
        }

        @keyframes floatBubble {
            0% { transform: translateY(100vh) scale(0.5); opacity: 0; }
            50% { opacity: 0.6; }
            100% { transform: translateY(-10vh) scale(1.2); opacity: 0; }
        }
        .bubble {
            position: absolute;
            background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.8), rgba(255,255,255,0.1));
            border: 1px solid rgba(255,255,255,0.6);
            border-radius: 50%;
            pointer-events: none;
            animation: floatBubble 12s infinite linear;
        }
    </style>
</head>
<body id="app-body" class="theme-sky min-h-screen text-slate-800 relative overflow-x-hidden">

